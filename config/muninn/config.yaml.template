model_list:
  # Local Ollama Model
  - model_name: ${OLLAMA_MODEL_NAME}
    litellm_params:
      model: ollama/${OLLAMA_MODEL_NAME}
      api_base: http://ollama:11434
      timeout: 1800
      stream_timeout: 1800

  # Role-named aliases across Google Gemini API (GEMINI_API_KEY, USD 35/30d cap inside
  # USD 40/mo Google Developer Program credits) and DeepSeek safety net (DEEPSEEK_API_KEY).
  # Consumers name a ROLE, never an upstream model, so the model behind a role
  # can be swapped here without touching any consumer. The anchors below are the
  # single places upstream slugs appear.
  # The complexity_router tiers name ALIASES, not upstream slugs: an alias
  # expands to the slug at parse time, which is not a registered model.
  #
  # Why `deepseek/deepseek-v4-flash` and not a shorter name:
  # `deepseek-v4-flash` is DeepSeek's current documented first-party API ID
  # (version DeepSeek-V4-Flash-0731) and LiteLLM's price map has a key for it,
  # so /v1/model/info keeps pricing + max_input_tokens and spend logs work.
  # A shorthand like `deepseek-flash` exists in neither catalog. Re-check both
  # before repointing: api-docs.deepseek.com/quick_start/pricing and
  # BerriAI/litellm model_prices_and_context_window.json.
  #
  # agent-loop            fast tier      - Antigravity overflow on Gemini 3.8 Flash -> DeepSeek
  # agent-delegate        reasoning tier - Delegation overflow on Gemini 3.8 Flash -> DeepSeek
  # agent-loop-deepseek   safety net     - Direct DeepSeek V4-Flash fallback
  # agent-delegate-deepseek safety net   - Direct DeepSeek V4-Pro fallback
  # memory-extract        fast tier      - Mnemosyne memory consolidation (Gemini 2.5 Flash-Lite)
  # compress              fast tier      - Hermes context compression summarizer (Gemini 2.5 Flash-Lite)
  # app-synthesize        fast tier      - Homelab app synthesis (Gemini 3.5 Flash-Lite)
  # agent-auto            complexity router (dormant)

  # Fast tier - Antigravity overflow for Hermes main agent loop.
  # Spends paid-tier Gemini API credits (USD 35/30d budget cap) before falling back to DeepSeek.
  - model_name: agent-loop
    litellm_params:
      model: &gemini_38_flash gemini/gemini-3.8-flash
      api_key: os.environ/GEMINI_API_KEY
      timeout: 600

  # Reasoning tier - Antigravity overflow for delegation / coding subagents.
  - model_name: agent-delegate
    litellm_params:
      model: *gemini_38_flash
      api_key: os.environ/GEMINI_API_KEY
      timeout: 600

  # Dedicated DeepSeek safety-net deployments (triggered when Gemini quota or USD 35/30d cap hits).
  - model_name: agent-loop-deepseek
    litellm_params:
      model: &flash deepseek/deepseek-v4-flash
      timeout: 600

  - model_name: agent-delegate-deepseek
    litellm_params:
      model: &pro deepseek/deepseek-v4-pro
      timeout: 600

  # Fast tier - Mnemosyne memory consolidation.
  # Routed to Gemini 2.5 Flash-Lite using GEMINI_API_KEY, with fallback to agent-loop-deepseek.
  - model_name: memory-extract
    litellm_params:
      model: &gemini_flash_lite gemini/gemini-2.5-flash-lite
      api_key: os.environ/GEMINI_API_KEY
      timeout: 120

  # Fast tier - Hermes context compression summarizer.
  # Routed to Gemini 2.5 Flash-Lite on Google API (1M context, ~2s latency, zero hidden
  # thinking token drain) using GEMINI_API_KEY, with fallback to agent-loop-deepseek.
  - model_name: compress
    litellm_params:
      model: *gemini_flash_lite
      api_key: os.environ/GEMINI_API_KEY
      timeout: 120

  # Fast tier - Homelab app protocol and scenario synthesis (Kratos, Midas/Plutus, Eir).
  # Upgraded to Gemini 3.5 Flash-Lite using GEMINI_API_KEY, with automatic fallback to
  # agent-loop-deepseek (DeepSeek V4-Flash).
  - model_name: app-synthesize
    litellm_params:
      model: &gemini_35_flash_lite gemini/gemini-3.5-flash-lite
      api_key: os.environ/GEMINI_API_KEY
      timeout: 120

  # Vision & receipt parsing tier - Gemini 4 Hydrogen via stateless agy-vision proxy (Antigravity subscription).
  - model_name: gemini-4-hydrogen
    litellm_params:
      model: openai/gemini-4-hydrogen-high
      api_base: http://agy-vision:8643/v1
      api_key: os.environ/API_SERVER_KEY
      timeout: 120

  # Fast tier - TypeSafe Jev System One decision and background monitor scorer.
  # Routed through local jev-shim service exposing OpenAI-compatible /v1/chat/completions.
  - model_name: agent-monitor
    litellm_params:
      model: openai/agent-monitor
      api_base: http://jev-shim:8000/v1
      api_key: "dummy"
      timeout: 30

  - model_name: jev-decision
    litellm_params:
      model: openai/jev-decision
      api_base: http://jev-shim:8000/v1
      api_key: "dummy"
      timeout: 30



  # Intelligent Router Model (Complexity-based routing) - dormant option.
  # Not wired to AGENT_MODEL; kept so the complexity router can be re-enabled
  # later by pointing AGENT_MODEL at agent-auto.
  - model_name: agent-auto
    litellm_params:
      model: auto_router/complexity_router
      complexity_router_config:
        tiers:
          SIMPLE: agent-loop
          MEDIUM: agent-loop
          COMPLEX: agent-delegate
          REASONING: agent-delegate
      complexity_router_default_model: agent-loop

  # Google Gemini Models (API key read from GEMINI_API_KEY environment variable)
  - model_name: gemini-2.5-flash-lite
    litellm_params:
      model: *gemini_flash_lite
      api_key: os.environ/GEMINI_API_KEY
      timeout: 600

  # Redirected from deprecated gemini-2.5-flash (Dec 1, 2026 shutdown) to Gemini 3.5 Flash-Lite
  - model_name: gemini-2.5-flash
    litellm_params:
      model: *gemini_35_flash_lite
      api_key: os.environ/GEMINI_API_KEY
      timeout: 600

  - model_name: gemini-2.5-pro
    litellm_params:
      model: gemini/gemini-2.5-pro
      api_key: os.environ/GEMINI_API_KEY
      timeout: 600

  - model_name: gemini-3.5-flash-lite
    litellm_params:
      model: *gemini_35_flash_lite
      api_key: os.environ/GEMINI_API_KEY
      timeout: 600

  - model_name: gemini-3.8-flash
    litellm_params:
      model: *gemini_38_flash
      api_key: os.environ/GEMINI_API_KEY
      timeout: 600

litellm_settings:
  fallbacks:
    - agent-loop:
        - agent-loop-deepseek
    - agent-delegate:
        - agent-delegate-deepseek
    - app-synthesize:
        - agent-loop-deepseek
    - compress:
        - agent-loop-deepseek
    - memory-extract:
        - agent-loop-deepseek
    - gemini-4-hydrogen:
        - gemini-3.5-flash-lite
        - agent-loop-deepseek

router_settings:
  # Cap Gemini API spend at USD 35/30d inside USD 40 monthly credits before failing over to DeepSeek.
  provider_budget_config:
    gemini:
      budget_limit: 35.0
      time_period: "30d"
  fallbacks:
    - agent-loop:
        - agent-loop-deepseek
    - agent-delegate:
        - agent-delegate-deepseek
    - app-synthesize:
        - agent-loop-deepseek
    - compress:
        - agent-loop-deepseek
    - memory-extract:
        - agent-loop-deepseek
    - gemini-4-hydrogen:
        - gemini-3.5-flash-lite
        - agent-loop-deepseek

general_settings:
  store_prompts_in_spend_logs: true
