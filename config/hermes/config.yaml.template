# Hermes Agent CLI Configuration
# Copy this file to cli-config.yaml and customize as needed.
# This file configures the CLI behavior. Environment variables in .env take precedence.

# =============================================================================
# Model Configuration
# =============================================================================
model:
  # Default model to use (can be overridden with --model flag).
  # AGENT_MODEL names a direct model exposed by the Antigravity subscription plugin
  # (claude-sonnet-5-5-high) rather than a muninn alias.
  # Minimal Hermes is strictly locked to Pool 2 claude-sonnet-5-5 via HERMES_AGY_ALLOWED_MODELS
  # to reserve Pool 1 Gemini headroom exclusively for Antigravity IDE. Orchestrator models are
  # avoided inside Hermes because external <tool_call> turns trigger Plan-Mode overhead on every step.
  default: "${AGENT_MODEL}"

  # Inference provider selection: the bundled Antigravity plugin, which shells
  # out to the `agy` CLI. There is deliberately no base_url/api_key here -- the
  # plugin talks to the local CLI (agy://local) and authenticates with the
  # OAuth token under the container's home dir (~/.gemini/antigravity-cli).
  provider: "antigravity-subscription-directsdk"

  # -- Token limits - two settings, easy to confuse --------------------------
  #
  # context_length: TOTAL context window (input + output tokens combined).
  #   Controls when Hermes compresses history and validates requests.
  #   Pinned to 200,000 tokens because the official agy CLI enforces an internal
  #   Exceeds200kTokens boundary and silently truncates payloads when single turns
  #   or conversation histories exceed ~200k tokens.
  context_length: 200000
  #
  # max_tokens: OUTPUT cap: maximum tokens the model may generate per response.
  #   Leave unset to use the model's native output ceiling (recommended).
  #
  # max_tokens: 8192

# =============================================================================
# Auxiliary Model Configuration
# =============================================================================
auxiliary:
  compression:
    # Compression runs primarily on Muninn compress (Gemini 3.5 Flash-Lite, 1M context,
    # falling back to DeepSeek on Muninn) to preserve Antigravity subscription quotas,
    # with Antigravity Pool 2 Claude Sonnet 5.5 Medium as fallback.
    provider: "custom"
    model: "compress"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"
    context_length: 1048576
    timeout: 60
    fallback_chain: &compression_fallbacks
      - provider: "antigravity-subscription-directsdk"
        model: "claude-sonnet-5-5-medium"
        timeout: 120
    fallback_providers: *compression_fallbacks

  memory:
    # Mnemosyne memory consolidation and structured fact extraction run primarily on Muninn
    # memory-extract (Gemini 3.8 Flash -> DeepSeek), falling back strictly to
    # Antigravity Pool 2 Claude Sonnet 5.5 Medium.
    provider: "custom"
    model: "memory-extract"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"
    timeout: 120
    fallback_chain: &memory_fallbacks
      - provider: "antigravity-subscription-directsdk"
        model: "claude-sonnet-5-5-medium"
    fallback_providers: *memory_fallbacks

  background_review:
    # Background skill reviews run primarily on Muninn app-synthesize (Gemini 3.8 Flash ->
    # DeepSeek), falling back strictly to Antigravity Pool 2 Claude Sonnet 5.5 Medium.
    provider: "custom"
    model: "app-synthesize"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"
    fallback_chain: &background_review_fallbacks
      - provider: "antigravity-subscription-directsdk"
        model: "claude-sonnet-5-5-medium"
    fallback_providers: *background_review_fallbacks

  title_generation:
    # Session and thread title generation runs primarily on Muninn compress (Gemini 3.5 Flash-Lite
    # -> DeepSeek), falling back strictly to Antigravity Pool 2 Claude Sonnet 5.5 Low.
    provider: "custom"
    model: "compress"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"
    fallback_chain: &title_generation_fallbacks
      - provider: "antigravity-subscription-directsdk"
        model: "claude-sonnet-5-5-low"
    fallback_providers: *title_generation_fallbacks

  approval:
    # Fast, low-cost smart command approval using TypeSafe Jev System One decision model.
    # Evaluates non-preapproved tool executions via typed choice/noul questions.
    provider: "typesafe-jev"
    model: "jev-latest"
    timeout: 30

  monitor:
    # High-volume background check and inbox urgency scoring (0-10) using TypeSafe Jev via Muninn
    provider: "custom"
    model: "agent-monitor"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"
    timeout: 30


# =============================================================================
# Fallback chain (main agent loop)
# =============================================================================
# Minimal single-coordinator Odin runs strictly on Pool 2 (Claude Sonnet 5.5) first
# and falls back directly to agent-loop on muninn (Gemini 3.8 Flash with USD 35/30d
# cap -> DeepSeek V4-Flash), keeping Pool 1 Gemini headroom reserved for Antigravity IDE.
fallback_providers:
  - provider: "custom"
    model: "agent-loop"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"

# =============================================================================
# Delegation Configuration (coding/subagent model)
# =============================================================================
delegation:
  # Delegated subagents run primarily on Muninn agent-delegate (Gemini 3.8 Flash via
  # named providers.muninn -> DeepSeek overflow) and fall back to Pool 2 Claude Sonnet 5.5 High.
  # Named provider "muninn" resolves key_env from providers.muninn (bare provider: "custom"
  # does not read key_env in delegation config).
  provider: "muninn"
  model: "agent-delegate"
  fallback_providers:
    - provider: "antigravity-subscription-directsdk"
      model: "claude-sonnet-5-5-high"

# =============================================================================
# Safety & Approvals
# =============================================================================
approvals:
  mode: smart
  smart_policy: >-
    Killing browser processes and deleting cache or temporary directories are routine.
    Ordinary git and gh operations on feature branches are routine.
    Force-pushing, rewriting published history, pushing to main, production databases,
    and shared infrastructure still require review.

# =============================================================================
# Provider Configuration
# =============================================================================
providers:
  custom:
    request_timeout_seconds: 300
    stale_timeout_seconds: 300
  muninn:
    name: "muninn"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"
    api_mode: "chat_completions"
    request_timeout_seconds: 300
    stale_timeout_seconds: 300

# =============================================================================
# Terminal Tool Configuration
# =============================================================================
terminal:
  backend: "local"
  cwd: "."  # For local backend: "." = current directory.
  timeout: 180
  docker_mount_cwd_to_workspace: false
  lifetime_seconds: 300

# --- Container resource limits ---
  container_cpu: 1              # CPU cores
  container_memory: 5120        # Memory in MB (5120 = 5GB)
  container_disk: 51200         # Disk in MB (51200 = 50GB)
  container_persistent: true    # Persist filesystem across sessions

# =============================================================================
# Browser Tool Configuration
# =============================================================================
browser:
  # Inactivity timeout in seconds - browser sessions are automatically closed
  inactivity_timeout: 120

  # Camofox anti-detection browser (Firefox-based fingerprint spoofing)
  camofox:
    # Enable persistence so cookies and logins survive across sessions
    managed_persistence: true

# =============================================================================
# Tool Loop Guardrails
# =============================================================================
tool_loop_guardrails:
  warnings_enabled: true
  hard_stop_enabled: false
  warn_after:
    exact_failure: 2
    same_tool_failure: 3
    idempotent_no_progress: 2
  hard_stop_after:
    exact_failure: 5
    same_tool_failure: 8
    idempotent_no_progress: 5

# =============================================================================
# Context Compression (Auto-shrinks long conversations)
# =============================================================================
compression:
  # Enable automatic context compression (default: true)
  enabled: true
  
  # Trigger compression at this % of model's context limit (0.80 = 80% of context window)
  threshold: 0.80
  # Absolute token cap for agy 200k context: trigger at 160k tokens (80% of agy 200k ceiling)
  threshold_tokens: 160000
  
  # Fraction of the threshold to preserve as recent tail (default: 0.20 = 20%)
  target_ratio: 0.20
  
  # Number of most-recent messages to always preserve (default: 20)
  protect_last_n: 20
  # Deterministic no-LLM prune of old tool results when the prompt exceeds this many tokens (0 = off).
  # Set to 120000: above the normal 60k-105k multi-turn cached working set (so typical turns stay
  # 100% on the persistent agy worker at 90-97% cache hit with zero extra cache busts), and below
  # the 160000 hard compaction threshold so long multi-turn sessions strip old prior-turn tool
  # results and flush hidden agy server-side thinking bloat before hitting full compaction.
  proactive_prune_tokens: 120000

# =============================================================================
# Memory Configuration
# =============================================================================
memory:
  provider: mnemosyne

  # Native file-based memory (MEMORY.md / USER.md) is DISABLED.
  # Mnemosyne is the single agent-facing memory store.
  #
  # Consequence: the ~2,200-char always-injected block (old "Layer 2") no longer
  # exists. Always-on facts now live in the Mnemosyne persona tier (Layer 1).
  # Mnemosyne tools are injected independently of these flags, so the provider
  # below keeps working. SOUL.md is an identity slot and is NOT affected.
  memory_enabled: false
  user_profile_enabled: false

  # Mnemosyne-specific settings
  mnemosyne:
    auto_sleep: true            # Enable automatic consolidation (sleep cycle summaries)
    sleep_threshold: 50         # Number of working memories before trigger
    vector_type: "int8"         # Vector quantization type (float32, int8, or bit)
    db_path: "/opt/data/.hermes/mnemosyne/data/mnemosyne.db"
    default_scope: "global"     # Align with Mnemosyne 4.0 cross-session accessibility
    polyphonic_recall: true     # Multi-voice hybrid scoring (vec, fts, keyword, importance, recency)
    enhanced_recall: true       # Enhanced semantic & contextual retrieval
    tools:
      - "mnemosyne_recall"
      - "mnemosyne_remember"
      - "mnemosyne_get"
      - "mnemosyne_update"
      - "mnemosyne_forget"
      - "mnemosyne_invalidate"
      - "mnemosyne_validate"
      - "mnemosyne_stats"
    skip_contexts:
      - "flush"
      - "subagent"
      - "background"
      - "skill_loop"

# =============================================================================
# Search Configuration
# =============================================================================
search_backend: searxng

# =============================================================================
# Extract Configuration
# =============================================================================
web:
  extract_backend: tavily

# =============================================================================
# Plugins Configuration
# =============================================================================
plugins:
  enabled:
    - "mnemosyne"
    - "antigravity-subscription-directsdk"
    - "jev-approvals"

# =============================================================================
# MCP Servers
# =============================================================================
# Main 'odin' Coordinator attaches 0 MCP servers to keep base turn overhead minimal.
mcp_servers: {}

# =============================================================================
# Platform Toolsets (Odin Top-Level Coordinator)
# =============================================================================
platform_toolsets:
  discord:
    - clarify
    - cronjob
    - delegation
    - discord
    - file
    - memory
    - skills
    - terminal
  cli:
    - cronjob
    - delegation
    - file
    - memory
    - skills
    - terminal



