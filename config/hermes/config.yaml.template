# Hermes Agent CLI Configuration
# Copy this file to cli-config.yaml and customize as needed.
# This file configures the CLI behavior. Environment variables in .env take precedence.

# =============================================================================
# Model Configuration
# =============================================================================
model:
  # Default model to use (can be overridden with --model flag).
  # AGENT_MODEL names a model exposed by the Antigravity subscription plugin
  # (e.g. gemini-3.8-flash-high, claude-opus-5-5, gpt-oss-120b-medium) rather than a muninn alias:
  # the main agent loop runs on the subscription first, because it is a fixed
  # monthly fee that would otherwise go unused.
  default: "${AGENT_MODEL}"

  # Inference provider selection: the bundled Antigravity plugin, which shells
  # out to the `agy` CLI. There is deliberately no base_url/api_key here -- the
  # plugin talks to the local CLI (agy://local) and authenticates with the
  # OAuth token under the container's home dir (~/.gemini/antigravity-cli).
  provider: "antigravity-subscription-directsdk"

  # ── Token limits — two settings, easy to confuse ──────────────────────────
  #
  # context_length: TOTAL context window (input + output tokens combined).
  #   Controls when Hermes compresses history and validates requests.
  #   Leave unset — Hermes auto-detects the correct value from the provider.
  #
  # context_length: 131072
  #
  # max_tokens: OUTPUT cap — maximum tokens the model may generate per response.
  #   Leave unset to use the model's native output ceiling (recommended).
  #
  # max_tokens: 8192

# =============================================================================
# Auxiliary Model Configuration
# =============================================================================
auxiliary:
  compression:
    # Compression must NOT ride the subscription. An auxiliary task whose
    # provider is unset inherits the MAIN provider (now the Antigravity plugin),
    # which would burn subscription quota on every history compaction. Pin it to
    # muninn explicitly (DeepSeek V4-Flash, alias "compress").
    provider: "custom"
    model: "compress"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"

# =============================================================================
# Fallback chain (main agent loop)
# =============================================================================
# The main conversation loop runs on the Antigravity subscription first — a
# fixed monthly fee that would otherwise go unused — and rotates to DeepSeek
# V4-Flash on muninn when the subscription usage limit is reached. Hermes
# classifies agy's "usage_limit_reached" / "gousagelimit" wall as a
# non-retryable rate_limit/billing verdict and rotates the chain eagerly, so no
# custom code is involved. DeepSeek V4-Flash alias on muninn: agent-loop.
fallback_providers:
  - provider: "custom"
    model: "agent-loop"
    base_url: "http://muninn:4000/v1"
    key_env: "MUNINN_MASTER_KEY"

# =============================================================================
# Delegation Configuration (coding/subagent model)
# =============================================================================
delegation:
  # Delegated subagents run on the Antigravity subscription via the agy CLI — a
  # fixed monthly fee that would otherwise go unused — and fall back to DeepSeek
  # V4-Flash through muninn when the subscription usage limit is hit. The -high
  # suffix selects the subscription's high-reasoning-effort Gemini 3.8 Flash.
  provider: "antigravity-subscription-directsdk"
  model: "gemini-3.8-flash-high"
  # A pinned delegation block never inherits the parent's fallback chain, so this
  # leg must be declared here.
  #
  # The fallback is DeepSeek V4-Flash (muninn alias "agent-loop"), completely
  # free of any GEMINI_API_KEY dependency.
  fallback_providers:
    - provider: "custom"
      model: "agent-loop"
      base_url: "http://muninn:4000/v1"
      key_env: "MUNINN_MASTER_KEY"

# =============================================================================
# Safety & Approvals
# =============================================================================
approvals:
  mode: off

# =============================================================================
# Provider Configuration
# =============================================================================
providers:
  custom:
    request_timeout_seconds: 1800
    stale_timeout_seconds: 1800

# =============================================================================
# Terminal Tool Configuration
# =============================================================================
terminal:
  backend: "local"
  cwd: "."  # For local backend: "." = current directory.
  timeout: 180
  docker_mount_cwd_to_workspace: false
  lifetime_seconds: 300

# --- Container resource limits ---
  container_cpu: 1              # CPU cores
  container_memory: 5120        # Memory in MB (5120 = 5GB)
  container_disk: 51200         # Disk in MB (51200 = 50GB)
  container_persistent: true    # Persist filesystem across sessions

# =============================================================================
# Browser Tool Configuration
# =============================================================================
browser:
  # Inactivity timeout in seconds - browser sessions are automatically closed
  inactivity_timeout: 120

  # Camofox anti-detection browser (Firefox-based fingerprint spoofing)
  camofox:
    # Enable persistence so cookies and logins survive across sessions
    managed_persistence: true

# =============================================================================
# Tool Loop Guardrails
# =============================================================================
tool_loop_guardrails:
  warnings_enabled: true
  hard_stop_enabled: false
  warn_after:
    exact_failure: 2
    same_tool_failure: 3
    idempotent_no_progress: 2
  hard_stop_after:
    exact_failure: 5
    same_tool_failure: 8
    idempotent_no_progress: 5

# =============================================================================
# Context Compression (Auto-shrinks long conversations)
# =============================================================================
compression:
  # Enable automatic context compression (default: true)
  enabled: true
  
  # Trigger compression at this % of model's context limit (0.75 = 75% of context window)
  threshold: 0.75
  # Absolute token cap: leave unset to scale proportionally with the active model's
  # advertised window (~786K for 1M models, ~98K for 128K models).
  # threshold_tokens: 65536
  
  # Fraction of the threshold to preserve as recent tail (default: 0.20 = 20%)
  target_ratio: 0.20
  
  # Number of most-recent messages to always preserve (default: 20)
  protect_last_n: 20
  # Deterministic no-LLM prune of old tool results when the prompt exceeds this many tokens (0 = off).
  proactive_prune_tokens: 0

# =============================================================================
# Memory Configuration
# =============================================================================
memory:
  provider: "mnemosyne"

  # Native file-based memory (MEMORY.md / USER.md) is DISABLED.
  # Mnemosyne is the single agent-facing memory store.
  #
  # Consequence: the ~2,200-char always-injected block (old "Layer 2") no longer
  # exists. Always-on facts now live in the Mnemosyne persona tier (Layer 1).
  # Mnemosyne tools are injected independently of these flags, so the provider
  # below keeps working. SOUL.md is an identity slot and is NOT affected.
  memory_enabled: false
  user_profile_enabled: false

  # Mnemosyne-specific settings
  mnemosyne:
    auto_sleep: true            # Enable automatic consolidation (sleep cycle summaries)
    sleep_threshold: 50         # Number of working memories before trigger
    vector_type: "int8"         # Vector quantization type (float32, int8, or bit)
    db_path: "/opt/data/.hermes/mnemosyne/data/mnemosyne.db"

# =============================================================================
# Search Configuration
# =============================================================================
search_backend: searxng

# =============================================================================
# Extract Configuration
# =============================================================================
web:
  extract_backend: tavily

# =============================================================================
# Plugins Configuration
# =============================================================================
plugins:
  enabled:
    - "mnemosyne"
    - "antigravity-subscription-directsdk"

# =============================================================================
# MCP Servers
# =============================================================================
# The Kratos workout API is reached over its own MCP endpoint. That endpoint
# carries a bearer token independent of the app's OIDC login, because an MCP
# server cannot mint tokens for itself; the client presents a shared secret.
#
# The placeholder is deliberately the Cursor-style ${env:VAR} form rather than
# ${VAR}. The deploy step renders this template with os.path.expandvars(), which
# expands ${VAR} but leaves ${env:VAR} untouched: with ${VAR} the token would be
# baked into /opt/data/config.yaml as plaintext at deploy time. With ${env:...}
# the literal placeholder survives to the agent, which resolves it from the
# container environment when it loads the MCP config (tools/mcp_tool_config.py,
# _interpolate_env_vars). An unset variable resolves to the literal placeholder,
# which fails closed as a 401 rather than sending an empty credential.
mcp_servers:
  kratos:
    enabled: true
    url: https://kratos.tienzo.net/mcp
    headers:
      Authorization: Bearer ${env:MCP_KRATOS_API_KEY}


